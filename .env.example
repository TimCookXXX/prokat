# === Node ===
# NODE_ENV выставляет next автоматически (next dev → development, next build → production).
# Прописывать его в .env вредно: если оставить development и запустить `pnpm build`,
# Next бандлит dev-вариант _error-страницы с <Html> и сборка падает на /404.

# === Домен / URL ===
DOMAIN=localhost
LETSENCRYPT_EMAIL=                   # email для Let's Encrypt; обязателен в production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                     # openssl rand -base64 32

# === БД (используется в docker-compose и приложением) ===
DB_PASSWORD=devpassword
DATABASE_URL=postgres://app:devpassword@localhost:5432/app

# === OAuth (только разрешённые в РФ; раскомментируй и заполни нужные) ===
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# VK ID — единый шлюз для VK / Mail.ru / OK (provider=vkid|mail_ru|ok_ru)
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# === Почта (регистрация и вход по паролю) ===
# Без SMTP_* письма печатаются в консоль (только вне production), а в проде
# регистрация и сброс пароля скрыты — вход по уже заведённому паролю работает.
# Заполнять все пять или ни одной.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=noreply@example.ru
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.ru
# Добавляется к встроенному стоп-листу иностранных почтовых сервисов
# (src/lib/auth/email.ts); закрывается рестартом, без пересборки.
# BLOCKED_EMAIL_DOMAINS=

# === Хранилище (Timeweb S3 / совместимое S3) — план 3 ===
# STORAGE_ENDPOINT=https://s3.timeweb.cloud
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE=https://images.example.ru

# === Бэкапы (план 6) ===
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# === SEO (план 6) ===
# INDEXNOW_KEY=

# Ключ 2ГИС — только для перекалибровки профиля OSRM (scripts/osrm/calibration), сайт его не использует.
# DGIS_API_KEY=

# === Адреса (поле «Где», адреса прокатов при импорте) — свой геокодер, без ключей ===
# Данные — таблицы geo_* (OSM + ГАР ФНС), их пишет scripts/geocoder/prepare.sh (docs/DEPLOY.md).
# Нет импорта в БД — работают микрорайоны, округа и геолокация браузера.
# Запасной путь (dev, тесты): готовый JSON индекса (pnpm db:export-geo) вместо таблиц.
# GEOCODER_INDEX_FILE=data/geocoder/build/index.krasnodar.json

# === Маршруты по дорогам: свой OSRM → по прямой ===
# Граф: bash scripts/osrm/prepare.sh (профиль scripts/osrm/profile, откалиброван по 2ГИС),
# сервис: docker compose up -d osrm.
# В docker-compose приложению задан http://osrm:5000; локально с dev-сервером:
# OSRM_URL=http://127.0.0.1:5001

# === Аналитика (план 6) ===
# YANDEX_METRIKA_ID=

# === Функции ===
# Старый P2P-контур: объявления пользователей, календарь занятости, заявки на
# бронь. Выключен по умолчанию — страницы отвечают 404, входы в UI скрыты.
# FEATURE_P2P=false
